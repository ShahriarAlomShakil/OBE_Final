# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{js,jsx,ts,tsx,json}]
indent_size = 2

[*.{css,scss,sass}]
indent_size = 2

[*.{html,xml}]
indent_size = 2

[*.sql]
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
