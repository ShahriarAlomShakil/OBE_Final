# ============================================
# OBE System Environment Variables
# ============================================
# Copy this file to .env and update with your actual values

# Application
NODE_ENV=development
PORT=3000
APP_NAME="OBE System"
APP_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=obe_user
DB_PASSWORD=your_secure_password
DB_NAME=obe_system
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT=60000

# Test Database Configuration
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=obe_user
TEST_DB_PASSWORD=your_secure_password
TEST_DB_NAME=obe_system_test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_RESET_PASSWORD_EXPIRY=10m
JWT_EMAIL_VERIFICATION_EXPIRY=24h

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=obe:
REDIS_QUEUE_DB=1

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=10000
EMAIL_FROM=noreply@obesystem.com
EMAIL_FROM_NAME="OBE System"
EMAIL_TEMPLATES_ENABLED=true
EMAIL_TEMPLATES_PATH=./templates/emails
EMAIL_TEMPLATE_ENGINE=ejs
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_NAME=email
EMAIL_QUEUE_ATTEMPTS=3
EMAIL_QUEUE_BACKOFF=5000
EMAIL_RATE_LIMIT_ENABLED=true
EMAIL_RATE_LIMIT_PER_HOUR=100
EMAIL_RATE_LIMIT_PER_DAY=1000
EMAIL_MAX_ATTACHMENT_SIZE=5242880
EMAIL_TRACK_OPENS=false
EMAIL_TRACK_CLICKS=false
EMAIL_TESTING_ENABLED=false
EMAIL_INTERCEPT_EMAIL=
EMAIL_USE_ETHEREAL=false

# File Storage Configuration
STORAGE_TYPE=local
# For local storage
STORAGE_LOCAL_PATH=./uploads
# For AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_ACL=private
# For MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=obe-system
MINIO_REGION=us-east-1
# Storage URL expiration (in seconds)
STORAGE_VIEW_URL_EXPIRY=3600
STORAGE_DOWNLOAD_URL_EXPIRY=300
STORAGE_UPLOAD_URL_EXPIRY=600

# Queue Configuration
QUEUE_ENABLED=true
QUEUE_PREFIX=obe:queue:
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000
QUEUE_REMOVE_ON_COMPLETE=100
QUEUE_REMOVE_ON_FAIL=50
QUEUE_JOB_TIMEOUT=60000
QUEUE_LOCK_DURATION=30000
QUEUE_LOCK_RENEW_TIME=15000
QUEUE_STALLED_INTERVAL=30000
QUEUE_MAX_STALLED_COUNT=3
QUEUE_GUARD_INTERVAL=5000
QUEUE_RETRY_PROCESS_DELAY=5000
QUEUE_EMAIL_CONCURRENCY=5
QUEUE_NOTIFICATION_CONCURRENCY=10
QUEUE_REPORT_CONCURRENCY=2
QUEUE_EXPORT_CONCURRENCY=2
QUEUE_IMPORT_CONCURRENCY=1
QUEUE_ASSESSMENT_CONCURRENCY=3
QUEUE_CALCULATION_CONCURRENCY=5
QUEUE_RATE_LIMIT_MAX=100
QUEUE_RATE_LIMIT_DURATION=1000
QUEUE_MONITORING_ENABLED=true
QUEUE_MONITORING_INTERVAL=60000

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
SESSION_SECRET=your-session-secret-change-this
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15
TWO_FACTOR_ENABLED=false
IP_WHITELIST=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Application Features
HELMET_ENABLED=true
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173
XSS_PROTECTION_ENABLED=true
MONGO_SANITIZE_ENABLED=true
HPP_ENABLED=true
FEATURE_SWAGGER_ENABLED=true
MAINTENANCE_MODE=false
FEATURE_REGISTRATION_ENABLED=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_TWO_FACTOR=false
FEATURE_SOCIAL_LOGIN=false
FEATURE_NOTIFICATIONS=true
FEATURE_ANALYTICS=false

# OAuth Configuration (Optional)
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Cache Configuration
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_PREFIX=obe:cache:

# Session Configuration
SESSION_ENABLED=true
SESSION_STORE=redis
SESSION_TTL=86400
SESSION_CHECK_PERIOD=3600

# WebSocket Configuration
WEBSOCKET_ENABLED=false
WEBSOCKET_PATH=/socket.io
WEBSOCKET_PING_TIMEOUT=60000
WEBSOCKET_PING_INTERVAL=25000

# Academic Configuration
CURRENT_ACADEMIC_SESSION=
GRADE_SYSTEM=4.0
PASSING_GRADE=2.0

# Pagination
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# File Upload
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=5

# Server Configuration
SERVER_HOST=0.0.0.0
TRUST_PROXY=false
BEHIND_PROXY=false
MAX_REQUEST_SIZE=10mb
API_TIMEOUT=30000

# Monitoring
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
METRICS_ENABLED=false
METRICS_PATH=/metrics

# Logging
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILENAME=app-%DATE%.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_FORMAT=json

# Frontend URL (for CORS) - deprecated, use CORS_ORIGIN
FRONTEND_URL=http://localhost:5173

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Date and Time
TZ=UTC
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm:ss
DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss
